# Environment template. Copy to backend/.env and fill in.
#
#   cp .env.example backend/.env
#
# NEVER put real credentials in this file — it is committed. Values below are either
# placeholders or local-only defaults that match backend/docker-compose.yml.
# Later issues append their own variables here.

# --- Database ---------------------------------------------------------------

# Primary Postgres connection for the running app. Solid Queue's tables live in this
# same database, so this is the only database URL the app needs.
# Local default matches the `postgres` service in backend/docker-compose.yml.
# In production this is injected by the host and points at the managed Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aea_onboarding_development

# Postgres connection used by the RSpec suite. MUST be a local database and MUST NOT
# be the same as DATABASE_URL: the suite truncates and rolls back every table.
# Falls back to DATABASE_URL when unset, which is only safe if DATABASE_URL is local.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aea_onboarding_test

# --- Neon (deployed database) -----------------------------------------------
#
# Production runs on Neon Postgres 17 (project "aea-investors", us-east-1), which
# encrypts at rest and requires TLS. Local development deliberately uses the Docker
# Postgres above instead: it is faster, works offline, and does not burn the Neon
# free tier's 100 CU-hours/month.
#
# Branches:
#   main  -> production, injected by Railway as DATABASE_URL
#   dev   -> scratch/pre-production checks from a laptop
#
# ALWAYS use the DIRECT (non-pooled) endpoint, never the "-pooler" host. Rails
# migrations take a session-level advisory lock (pg_advisory_lock) and Neon's
# PgBouncer runs in transaction pooling mode, which does not support them — a
# migration through the pooler hangs rather than failing loudly.
#
# Keep the ?sslmode=require&channel_binding=require parameters. Neon rejects
# non-TLS connections outright.
#
# Retrieve with (never paste a real value into this file):
#   neon connection-string <branch> --project-id billowing-leaf-57532149 \
#     --role-name neondb_owner --database-name neondb
#
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Rails ------------------------------------------------------------------

# Puma threads per process, and the Active Record connection pool size (they are read
# from the same variable so the pool can never be smaller than the thread count).
RAILS_MAX_THREADS=5

# Which config/environments/*.rb file boots. Leave unset locally (Rails defaults to
# "development"); the host sets "production" on the deployed app.
# RAILS_ENV=development
